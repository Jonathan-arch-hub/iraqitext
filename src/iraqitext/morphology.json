  "version": 1,
  "about": "Hand-written Iraqi Arabic morphology: pronouns, negation, tense/aspect markers, clitics, object suffixes and verb paradigms. Nothing here is copied from a copyrighted dictionary; every entry is a small human-authored paradigm that the engine expands into thousands of surface forms.",
  "license": "MIT (same as the package)",
  "msa_prefixes": {
    "1sg": "أ",
    "2ms": "ت",
    "2fs": "ت",
    "3ms": "ي",
    "3fs": "ت",
    "1pl": "ن",
    "2pl": "ت",
    "3pl": "ي"
  },
