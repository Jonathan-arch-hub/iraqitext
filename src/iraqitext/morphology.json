    "3fs": "ت",
    "1pl": "نا",
    "2pl": "تم",
    "3pl": "وا"
  },
  "person_prefixes": {
    "أ": {
      "person": "1sg",
      "note": "1sg: أروح / أگدر"
    },
    "ا": {
      "person": "1sg",
      "note": "1sg without hamza: اكول / اشتغل"
    },
    "ت": {
      "person": "2ms",
      "note": "2sg masculine: تروح / تگدر"
    },
    "ن": {
      "person": "1pl",
      "note": "1pl: نروح / نگدر"
    },
    "ي": {
      "person": "3ms",
      "note": "3sg: يروح / يگدر; the 3pl adds a plural marker (يروحون)"
    }
  },
  "plural_suffixes": {
    "ون": {
      "person": "3pl",
      "note": "يروحون / تشتغلون"
    },
    "ين": {
      "person": "3pl",
      "note": "يگدرين"
    },
    "هه": {
      "person": "3pl",
      "note": "يروحهه"
    }
  },
  "subject_suffixes_present": {
    "ين": {
      "person": "2fs",
      "note": "2fs present: أروحين / تعرفين → تذهبين / تعرفين"
    },
    "ي": {
      "person": "1sg",
      "note": "emphatic 1sg: أروحي → أذهب أنا"
    },
    "ن": {
      "person": "1pl",
      "note": "emphatic 1pl: نروحن → نذهب نحن"
    },
    "وا": {
      "person": "3pl",
      "note": "subjunctive 3pl: روحوا → يروحون"
    }
  },
  "subject_suffixes_past": {
    "ت": {
      "person": "2ms",
      "note": "راحت → ذهبت (same MSA form as 3fs)"
    },
    "نا": {
      "person": "1pl",
      "note": "راحنا → ذهبنا"
    },
    "وا": {
      "person": "3pl",
      "note": "راحوا → ذهبوا"
    },
    "توا": {
      "person": "2pl",
      "note": "راحتوا →ذهبتم"
    }
  },
