  "compositions": [
    {
      "id": "future.sara",
      "op": "future",
      "markers": [
        "راح",
        "رح"
      ],
      "msa": "س",
      "placement": "verb_prefix",
      "requires_verb": true,
      "note": "راح + imperfective verb → سـ + the same verb. The marker word disappears (dictionary.json maps a bare راح to سوف).",
      "example": {
        "in": "راح أگلك شصار",
        "out": "سأخبرك بما حدث",
        "level": "sentence"
      }
    },
    {
      "id": "negation.mahood",
      "op": "negation",
      "markers": [
        "ما"
      ],
      "msa_present": "لا",
      "msa_past": "ما",
      "msa_single_past": "لم",
      "complement_present": "أن",
      "complement_past": "لـ",
      "requires_verb": true,
      "note": "ما + present verb (+ verb) → لا + imperfective (+ أن + imperfective). ما + past verb (+ verb) → ما + perfective (+ لـ + imperfective).",
      "example": {
        "in": "ما نكدر نجي",
        "out": "لا نستطيع أن نأتي",
        "level": "sentence"
      }
    },
    {
      "id": "present.da",
      "op": "present_marker",
      "markers": [
        "دا",
        "داك"
      ],
      "msa": "الآن",
      "placement": "clause_final",
      "requires_verb": true,
      "note": "Iraqi clauses start with دا, MSA puts الآن at the end: دا أحچي وياك → أتحدث معك الآن (same order the fixed entries دا أروح / دا أحچي use).",
      "example": {
        "in": "دا أحچي وياك",
        "out": "أتحدث معك الآن",
        "level": "sentence"
      }
    }
  ],
